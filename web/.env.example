# ---------------------------------------------------------------------------
# Supabase (Dashboard → Project Settings → API)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx
# ใช้เฉพาะฝั่ง Server (API Routes) — ห้ามขึ้นต้นด้วย NEXT_PUBLIC_ และห้าม commit
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Auth — คีย์ลับสำหรับลงลายเซ็น Token (สุ่มยาว ≥ 32 ตัวอักษร)
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me
# อีเมล Admin (คั่นด้วย ,) — หรือใส่ tag 'role:admin' ใน bot_config.symbols_trading
ADMIN_EMAILS=admin@goldbot24.com,admin@aitrade24.com

# ---------------------------------------------------------------------------
# Payment
# ---------------------------------------------------------------------------
PROMPTPAY_ID=0812345678
SLIPOK_BRANCH_ID=
SLIPOK_API_KEY=
# ---------------------------------------------------------------------------
# อีเมล (ลืมรหัสผ่าน) — SMTP เช่น Gmail + App Password (myaccount.google.com/apppasswords)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=GoldBot24 <you@gmail.com>

# Header x-webhook-secret ที่ผู้ให้บริการชำระเงินต้องส่งมากับ /api/webhook/payment
PAYMENT_WEBHOOK_SECRET=
# true = ข้ามการตรวจสลิปจริง (ใช้ได้เฉพาะเครื่องนักพัฒนา ไม่มีผลบน Production)
ALLOW_MOCK_SLIP=false
